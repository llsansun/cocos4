# Local Docker settings for this machine.

COCOS_4_0_SRC=/Users/libin/cocos4
COCOS_3_8_9_SRC=/Users/libin/cocos-engine
COCOS_3_8_7_SRC=/Users/libin/cocos-engine-3.8.7
COCOS_2_4_16_SRC=/Users/libin/cocos-engine-2.4.16
OUTPUT_DIR=/Users/libin/cocos-output
CACHE_DIR=/Users/libin/.cache/cocos-docker

# Optional overrides.
COCOS_4_0_IMAGE=cocos-dev:4.0
COCOS_4_0_BASE_IMAGE=public.ecr.aws/ubuntu/ubuntu:22.04
COCOS_4_0_INSTALL_ANDROID=false
COCOS_4_0_NODE_OPTIONS="--max-old-space-size=6144"
COCOS_4_0_INSTALL_CMD="npm install"
COCOS_4_0_INIT_CMD="npm run update:native-external"
COCOS_4_0_BUILD_CREATOR_CMD="npm run build"
COCOS_4_0_BUILD_ENGINE_CMD="npm run build"
COCOS_4_0_BUILD_CLI_CMD="npm run build:cli"

COCOS_3_8_IMAGE=cocos-dev:3.8
COCOS_3_8_BASE_IMAGE=public.ecr.aws/ubuntu/ubuntu:22.04
COCOS_3_8_INSTALL_ANDROID=false
COCOS_3_8_NODE_OPTIONS="--max-old-space-size=6144"

COCOS_2_4_IMAGE=cocos-dev:2.4
COCOS_2_4_BASE_IMAGE=public.ecr.aws/ubuntu/ubuntu:22.04
COCOS_2_4_NODE_OPTIONS="--max-old-space-size=6144"
