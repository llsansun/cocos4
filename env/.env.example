# Copy this file to .cocos-docker.env in the repository root and change paths for your machine.

COCOS_4_0_SRC=/absolute/path/to/cocos4
COCOS_3_8_9_SRC=/absolute/path/to/cocos-engine-3.8.9
COCOS_3_8_7_SRC=/absolute/path/to/cocos-engine-3.8.7
COCOS_2_4_16_SRC=/absolute/path/to/cocos-engine-2.4.16

OUTPUT_DIR=/absolute/path/to/cocos-output
CACHE_DIR=/absolute/path/to/.cache/cocos-docker

# Optional overrides.
# COCOS_4_0_IMAGE=cocos-dev:4.0
# COCOS_4_0_BASE_IMAGE=ubuntu:22.04
# COCOS_4_0_INSTALL_ANDROID=false
# COCOS_4_0_NODE_OPTIONS='--max-old-space-size=6144'
# COCOS_4_0_INSTALL_CMD='npm install'
# COCOS_4_0_INIT_CMD='npm run update:native-external'
# COCOS_4_0_BUILD_CREATOR_CMD='npm run build'
# COCOS_4_0_BUILD_ENGINE_CMD='npm run build'
# COCOS_4_0_BUILD_CLI_CMD='npm run build:cli'
# COCOS_4_0_PACK_ENGINE_CMD='if [ ! -f native/external/emscripten/webgpu/glslang.js ]; then npm run update:native-external; fi && npm run build && mkdir -p /workspace/output/engine && tar --exclude="./node_modules" --exclude="./native/node_modules" --exclude="./.git" -czf /workspace/output/engine/cocos-engine-4.0-$(date +%Y%m%d-%H%M%S).tar.gz bin cocos native pal platforms editor external exports extensions scripts templates licenses @types DebugInfos.json DebugInfos.d.ts EngineErrorMap.md package.json package-lock.json cc.config.json cc.config.schema.json README.md README.zh-CN.md LICENSE tsconfig.json predefine.ts'

# Cocos 3.8 defaults.
# COCOS_3_8_IMAGE=cocos-dev:3.8
# COCOS_3_8_BASE_IMAGE=ubuntu:22.04
# COCOS_3_8_INSTALL_ANDROID=false
# COCOS_3_8_NODE_OPTIONS='--max-old-space-size=6144'
# COCOS_3_8_INSTALL_CMD='npm ci'
# COCOS_3_8_INIT_CMD='cd native && npm install && npx gulp init'
# COCOS_3_8_BUILD_ENGINE_CMD='npm run build'
# COCOS_3_8_PACK_ENGINE_CMD='if [ ! -f native/external/emscripten/webgpu/glslang.js ]; then cd native && npm install && npx gulp init && cd ..; fi && npm run build && mkdir -p /workspace/output/engine && tar --exclude="./node_modules" --exclude="./native/node_modules" --exclude="./.git" -czf /workspace/output/engine/cocos-engine-3.8-$(date +%Y%m%d-%H%M%S).tar.gz bin cocos native pal platforms editor external exports extensions scripts templates licenses @types DebugInfos.json DebugInfos.d.ts EngineErrorMap.md package.json package-lock.json cc.config.json cc.config.schema.json README.md README.zh-CN.md LICENSE.md tsconfig.json predefine.ts'

# Cocos 2.4 defaults.
# COCOS_2_4_IMAGE=cocos-dev:2.4
# COCOS_2_4_BASE_IMAGE=ubuntu:22.04
# COCOS_2_4_NODE_OPTIONS='--max-old-space-size=6144'
# COCOS_2_4_INSTALL_CMD='npm install'
# COCOS_2_4_INIT_CMD='true'
# COCOS_2_4_BUILD_ENGINE_CMD='npx gulp build'
# COCOS_2_4_PACK_ENGINE_CMD='if [ ! -f external/box2d/box2d.js ]; then echo "Missing Cocos 2.4 external files. Please check out a complete 2.4.x engine source tree." >&2; exit 1; fi && npx gulp build && mkdir -p /workspace/output/engine && tar --exclude="./node_modules" --exclude="./.git" -czf /workspace/output/engine/cocos-engine-2.4-$(date +%Y%m%d-%H%M%S).tar.gz bin cocos2d editor extensions external gulp licenses polyfill DebugInfos.json EngineErrorMap.md package.json package-lock.json README.md api.d.ts modules.json gulpfile.js index.js extends.js predefine.js tsconfig.json CHANGELOG.txt AUTHORS.txt'
